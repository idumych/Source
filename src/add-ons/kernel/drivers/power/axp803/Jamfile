SubDir HAIKU_TOP src add-ons kernel drivers power axp803 ;

UsePrivateKernelHeaders ;
UseLibraryHeaders [ FDirName libfdt ] ;

local libFDTSources =
	fdt.c
	fdt_ro.c
;

KernelAddon axp803 :
	axp803.cpp
	$(libFDTSources)
	;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
